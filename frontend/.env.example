# Frontend Environment Variables
# Copy this to .env and update as needed

# Backend API URL
# - For local development: http://localhost:8000
# - For Docker: leave empty (nginx proxies /api to backend)
# - For tunnel: set to your cloudflare tunnel URL
VITE_BACKEND_URL=http://localhost:8000

# Microsoft Authentication (Azure AD / Entra ID)
# WPI uses Microsoft 365 Education - users can login via Microsoft Authenticator
#
# To enable Microsoft SSO:
# 1. Register app in WPI's Azure AD (requires WPI IT admin):
#    - Azure Portal > Azure Active Directory > App registrations
#    - App name: "WPI Digital Adviser"
#    - Supported account types: "Accounts in this organizational directory only"
#    - Redirect URI: http://localhost:5173 (dev), https://your-domain.com (prod)
#    - Enable ID tokens under Authentication
#
# 2. Copy the Application (client) ID here:
VITE_MSAL_CLIENT_ID=

# 3. Set WPI's tenant (use 'wpi.edu' or the specific tenant ID):
VITE_MSAL_TENANT_ID=wpi.edu

# Note: If VITE_MSAL_CLIENT_ID is empty, the app will show demo login form instead
