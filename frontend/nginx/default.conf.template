# Rendered by the nginx image's envsubst step at container start (only variables that are set
# in the environment are substituted; nginx's own $variables are left alone):
#   TRUSTED_PROXY_CIDR  - address range of a load balancer in front of nginx, if any
#   PUBLIC_HTTPS_PORT   - host port that maps to 8443, used in the HTTP -> HTTPS redirect
#   TLS_CERT_FILE / TLS_KEY_FILE - certificate chain and key (self-signed dev pair or Let's Encrypt)

# Outer brake on sign-in attempts per client IP (the backend also locks out after failures)
limit_req_zone $binary_remote_addr zone=auth_login:10m rate=10r/m;

# Plain HTTP: health checks and ACME challenges only, everything else is redirected to HTTPS
server {
    listen 8080;
    server_name _;

    # Let's Encrypt HTTP-01 challenges (written by the certbot container); must not redirect
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host:${PUBLIC_HTTPS_PORT}$request_uri;
    }
}

server {
    # Unprivileged nginx image: non-root, so listen on a high port
    listen 8443 ssl;
    http2 on;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    ssl_certificate ${TLS_CERT_FILE};
    ssl_certificate_key ${TLS_KEY_FILE};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Client IP for rate limits: trust X-Forwarded-For only from the configured proxy range
    set_real_ip_from ${TRUSTED_PROXY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # Transcript PDFs (10 MB) arrive base64-encoded inside JSON, ~1.34x larger
    client_max_body_size 15m;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/json;

    include /etc/nginx/snippets/security_headers.conf;

    # Main location
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Chat is Server-Sent Events: forward every chunk as soon as the backend writes it
    location = /api/chat {
        proxy_pass http://backend:8000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 300s;
        proxy_connect_timeout 75s;
    }

    # Sign-in endpoints (not /config or /me, which the UI calls freely): rate limited per IP
    location ~ ^/api/auth/(demo-login|microsoft)$ {
        limit_req zone=auth_login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://backend:8000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # API proxy to backend
    location /api {
        proxy_pass http://backend:8000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_connect_timeout 75s;
    }

    # Static files caching (add_header here would drop the server-level headers, so re-include them)
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/security_headers.conf;
    }

    # Error pages
    error_page 404 /index.html;
}
