  "faqs": [
    {
      "question": "What programs does WPI offer for graduate students?",
      "answer": "WPI offers three main Master's programs: MS in Information Technology (MSIT), MS in Business Analytics (MSBA), and MS in Management (MSM). All are 33 credits and can be completed in 6-12 months.",
      "tags": ["programs", "overview"]
    },
    {
      "question": "How many credits are required to graduate?",
      "answer": "All graduate programs require 33 total credits: 9 credits in core courses, 18 credits in two specializations, and 6 credits in capstone courses.",
      "tags": ["credits", "requirements", "graduation"]
    },
    {
      "question": "Can I choose my own specializations?",
      "answer": "Yes, you must choose TWO different specializations from the available options. Each specialization consists of 3 courses worth 9 credits total (6 credits from your 2 specializations = 18 credits).",
      "tags": ["specializations", "choice", "flexibility"]
    },
    {
      "question": "How long do I have to complete the program?",
      "answer": "The typical duration is 6-12 months depending on your pace. You can study full-time or part-time to fit your schedule.",
      "tags": ["duration", "timeline", "pace"]
    },
    {
      "question": "Are the programs available online?",
      "answer": "Yes, all programs offer online and on-campus options. Most courses are available in both formats.",
      "tags": ["online", "format", "delivery"]
    },
    {
      "question": "What are the admission prerequisites?",
      "answer": "Basic requirements include a bachelor's degree from an accredited university and a minimum GPA of 3.0. Specific programs may have additional requirements like programming courses or work experience.",
      "tags": ["admission", "prerequisites", "requirements"]
    },
