# Google API Configuration
GOOGLE_API_KEY=your_google_api_key_here

# Gemini Model
GEMINI_MODEL=gemini-3.8-flash

# LLM provider: gemini (default) or qwen. Override one role with
# LLM_PROVIDER_ADVISER / LLM_PROVIDER_INTENT / LLM_PROVIDER_COMPACTION
LLM_PROVIDER=gemini

# Qwen3-8B + LoRA adapter on an OpenAI-compatible server (vLLM), used when a role is "qwen"
# QWEN_BASE_URL=http://vllm:8001/v1
# QWEN_MODEL=adviser-lora          # vLLM --lora-modules name, or the base model to skip the adapter
# QWEN_API_KEY=EMPTY
# QWEN_ENABLE_THINKING=            # true/false; default: on for adviser, off for intent/compaction

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Chat context compaction: once the verbatim window passes either trigger, older turns are
# folded into a rolling summary in Redis and only the newest KEEP_RECENT messages stay verbatim
COMPACTION_TRIGGER_MESSAGES=16
COMPACTION_TRIGGER_TOKENS=6000
COMPACTION_KEEP_RECENT=6

# CORS Configuration
ALLOW_ALL_ORIGINS=false
ALLOWED_ORIGINS=http://localhost,http://localhost:80

# Streaming Configuration
STREAMING_DISABLED=false

# LangChain Debug Mode
LANGCHAIN_DEBUG=false

# Embedding Provider (google or local)
EMBEDDING_PROVIDER=google

# Frontend Configuration
VITE_BACKEND_URL=http://localhost:8000
