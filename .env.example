# Google API Configuration
GOOGLE_API_KEY=your_google_api_key_here

# Gemini Model
GEMINI_MODEL=gemini-3.8-flash

# LLM provider: gemini (default) or qwen. Override one role with
# LLM_PROVIDER_ADVISER / LLM_PROVIDER_INTENT / LLM_PROVIDER_COMPACTION
LLM_PROVIDER=gemini

# Qwen3-8B + LoRA adapter on an OpenAI-compatible server (vLLM), used when a role is "qwen"
# QWEN_BASE_URL=http://vllm:8001/v1
# QWEN_MODEL=adviser-lora          # vLLM --lora-modules name, or the base model to skip the adapter
# QWEN_API_KEY=EMPTY
# QWEN_ENABLE_THINKING=            # true/false; default: on for adviser, off for intent/compaction

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# Required by docker-compose: Redis runs with requirepass and is not published on the host
REDIS_PASSWORD=change-me-generate-with-secrets.token_urlsafe

# Auth: secret (>=32 chars) that signs backend access tokens and derives the transcript
# encryption key. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_JWT_SECRET=
APP_TOKEN_TTL_SECONDS=28800
# Optional dedicated Fernet key for transcript data at rest (else derived from APP_JWT_SECRET)
# CONTEXT_ENCRYPTION_KEY=
# Microsoft sign-in (Azure AD app registration); both empty = disabled
AZURE_CLIENT_ID=
AZURE_TENANT_ID=           # tenant GUID, not the domain
ALLOWED_EMAIL_DOMAINS=wpi.edu,alumni.wpi.edu
# Emails allowed to call /api/admin/*
ADMIN_EMAILS=
# Demo account (email + password). Keep disabled in production.
DEMO_LOGIN_ENABLED=false
DEMO_USER_EMAIL=demo@wpi.edu
DEMO_USER_PASSWORD=
# Largest transcript upload, in MB (nginx client_max_body_size must allow ~1.4x this)
MAX_TRANSCRIPT_MB=10
# Rate limits, stored in Redis so they hold across workers (0 disables one)
CHAT_RATE_LIMIT_PER_MINUTE=10
CHAT_RATE_LIMIT_PER_DAY=300
TRANSCRIPT_RATE_LIMIT_PER_HOUR=10
SUMMARY_RATE_LIMIT_PER_HOUR=20
STATUS_RATE_LIMIT_PER_MINUTE=6
MICROSOFT_LOGIN_RATE_LIMIT_PER_MINUTE=20
# Failed demo logins per email and per IP before a lockout of LOGIN_LOCKOUT_SECONDS
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
UVICORN_WORKERS=2

# Chat context compaction: once the verbatim window passes either trigger, older turns are
# folded into a rolling summary in Redis and only the newest KEEP_RECENT messages stay verbatim
COMPACTION_TRIGGER_MESSAGES=16
COMPACTION_TRIGGER_TOKENS=6000
COMPACTION_KEEP_RECENT=6

# CORS Configuration
ALLOW_ALL_ORIGINS=false
FRONTEND_URL=http://localhost:8080

# Streaming Configuration
STREAMING_DISABLED=false

# LangSmith tracing: one trace per chat turn (intent + agent + tools), grouped by session.
# Emails, student IDs and labelled names are masked before upload unless LANGSMITH_REDACT_PII=false.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=wpi-adviser
# EU region: https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_REDACT_PII=true

# LangChain Debug Mode
LANGCHAIN_DEBUG=false

# Embedding Provider (google or local)
EMBEDDING_PROVIDER=google

# Frontend Configuration
VITE_BACKEND_URL=http://localhost:8000
